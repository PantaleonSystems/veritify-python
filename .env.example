# Copy this file to .env and fill in your own values.
# .env is gitignored — never commit real values.

# Root URL of the Veritify API instance you're calling. Required (or pass
# base_url= explicitly when creating VeritifyClient). No public hosted
# endpoint exists yet — point this at an instance you run yourself, e.g.
# the local dev server.
VERITIFY_BASE_URL=http://localhost:8000

# Optional. Sent as a Bearer token. Not enforced by the API yet — safe to
# leave blank for now.
VERITIFY_API_KEY=
