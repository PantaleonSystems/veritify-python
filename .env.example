# Copy this file to .env and fill in your own values.
# .env is gitignored — never commit real values.

# Root URL of the Veritify API instance you're calling. Required (or pass
# base_url= explicitly when creating VeritifyClient). This is the current
# official public instance — it may move to a custom domain later, but
# this URL keeps working either way unless we announce otherwise.
VERITIFY_BASE_URL=https://veritify-api-production.up.railway.app

# Optional for most endpoints today, but you'll want one for anything past
# light testing (it gives you your own rate limit instead of sharing the
# anonymous one). Get a key for free, in seconds, with no approval wait —
# see examples/signup.py, or docs/getting-started.md.
VERITIFY_API_KEY=
